++def pair(status="HEDGED", protected="LONG", hedge="SHORT", **extra):
++    return {"status": status, "protectedSide": protected, "hedgeSide": hedge, "rehedgeEnabled": True,
++            "reservedHedgeQty": 0.0, "generationId": "g1", **extra}
