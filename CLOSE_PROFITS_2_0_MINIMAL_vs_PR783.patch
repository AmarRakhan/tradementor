+cd "$(dirname "$0")/.."
+export GCLOUD_PROJECT=close-profits-test-only
+export FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
+python3 -m venv /tmp/cp20-venv && . /tmp/cp20-venv/bin/activate
