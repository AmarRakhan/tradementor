+class UnknownOutcomeTests(Base):
+    def test_unknown_after_accept_one_order_fail_closed_no_retry_and_no_blind_release(self):
+        self.L.add("BTCUSDT", "SHORT", 8.0); self.L.add("BTCUSDT", "LONG", 8.0)
