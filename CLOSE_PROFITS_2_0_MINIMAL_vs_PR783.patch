+try:
+    import offline_close_harness as H
+    HAVE = True
+except Exception:  # pragma: no cover  (aster_gateway needs httpx)
+    HAVE = False
+
+KEY = lambda n: f"idempotency-key-{n:08d}"
+MAIN_SRC = (Path(__file__).parent / "main.py").read_text()
