+class FakeDoc:
+    def __init__(self, data, exists=True, raises=False):
+        self._data, self.exists, self._raises = data, exists, raises
+
+    def get(self):
+        if self._raises:
+            raise RuntimeError("firestore unavailable")
+        return self
+
+    def to_dict(self):
+        return self._data
