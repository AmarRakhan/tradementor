+    setBulkCloseTargets: () => {},
+    setProfitPreview: () => {},
+    onRetry: () => { state.refresh++; },
+    encodeURIComponent, JSON, Promise, Error, String,
+    newCloseIdempotencyKey: () => "unique-close-" + ++state.keys,
