++    module = ast.Module(body=[fn], type_ignores=[])
++    ast.fix_missing_locations(module)
++    names = {n.id for n in ast.walk(fn) if isinstance(n, ast.Name)}
++    return compile(module, "main.py::close_one_aster_position", "exec"), names
